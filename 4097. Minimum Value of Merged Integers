int minMergedInteger(vector<int>& nums) {
        int ans=INT_MAX;
        int n=nums.size();
        for(int i=0;i+1<n;i+=2){
            string a =to_string(nums[i]);
            string b =to_string(nums[i+1]);
            string merged=a+b;
            int temp=stoi(merged);
            ans=min(ans,temp);
        }
        return ans;
    }
