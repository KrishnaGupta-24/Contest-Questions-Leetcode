vector<int> maxProductPair(vector<int>& nums, int tar) {
        int max=INT_MIN;
        int prod=1;
        int a1=0,a2=0;
        bool  found=false;
        int n=nums.size();
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                if(i!=j){
                    if(nums[i]+nums[j]==tar&&nums[i]>nums[j]){
                        found=true;
                        prod=nums[i]*nums[j];
                        if(prod>max){
                            max=prod;
                            a1=i;
                            a2=j;
                        }
                    }
                }
            }
        }
        if(!found){
            return {-1,-1};
        }
        return {a1,a2};
    }
